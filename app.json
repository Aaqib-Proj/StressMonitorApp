{
  "expo": {
    "name": "CalmPulse",
    "slug": "calmpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/calmpulse.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/calmpulse.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/calmpulse.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.calmpulse.app",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "web": {
      "favicon": "./assets/images/calmpulse.png"
    }
  }
}
